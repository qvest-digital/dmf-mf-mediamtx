# The builder is go-mxl-builder because it ships libmxl under /opt/libmxl.
# Every reader and writer sharing an MXL domain must link a byte-identical
# libmxl, so the binary is built against the same one the writers and the node
# agent link, and the runtime stage carries that .so beside it.
# renovate: datasource=docker depName=ghcr.io/qvest-digital/go-mxl-builder
ARG GO_MXL_TAG=1.0.0-rc.9

# -------- 1. builder: cgo-link mediamtx against libmxl --------
FROM ghcr.io/qvest-digital/go-mxl-builder:${GO_MXL_TAG} AS builder
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV PKG_CONFIG_PATH=/opt/libmxl/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/libmxl/lib
ENV CGO_CFLAGS="-I/opt/libmxl/include"
ENV CGO_LDFLAGS="-L/opt/libmxl/lib -lmxl"
ENV CGO_ENABLED=1

COPY . /src/mediamtx
WORKDIR /src/mediamtx
RUN go mod download && go generate ./... \
 && go build -o /out/mediamtx . \
 && ldd /out/mediamtx | grep -E 'libmxl|not found' || true

# -------- 2. runtime: swap the binary into the published image --------
# The base supplies ffmpeg and the entrypoint. It is published by another
# repository, which makes this image depend on a package it does not own.
# Pinned by digest rather than :latest: that package stops receiving builds,
# so a floating tag would either sit still or move without warning, and
# neither is a property to build on. The digest is the 6cf0280 build.
FROM ghcr.io/qvest-digital/mxl-dmf-demo-app/mediamtx-mxl@sha256:0a9153b63ce429b60e268101e3ddb4d362228c05b90f5353f90e379b0a0bf2fa AS runtime
COPY --from=builder /out/mediamtx /usr/local/bin/mediamtx
COPY --from=builder /opt/libmxl/lib/ /opt/libmxl/lib/
# MIT requires the notice to travel with substantial portions of the work.
COPY LICENSE /usr/share/doc/mediamtx/LICENSE
ENV LD_LIBRARY_PATH=/opt/libmxl/lib
EXPOSE 8554 1935 8888 8889 8890
